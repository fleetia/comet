{
  "id": "first-meeting",
  "title": "처음 만나기",
  "purpose": "tutorial",
  "centerId": "character-1",
  "participants": [
    "character-1"
  ],
  "keywords": [
    "튜토리얼",
    "사용법 알려 줘"
  ],
  "allowRepeat": true,
  "chapters": [
    {
      "id": "start",
      "title": "등장",
      "steps": [
        {
          "kind": "move",
          "persona": "character-1",
          "enter": "right"
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "기쁨",
          "text": "안녕! 나는 별꼬리야."
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "오늘부터 네 바탕화면에서 같이 지낼 거야."
        },
        {
          "kind": "choice",
          "persona": "character-1",
          "expression": "호기심",
          "prompt": "여기서 어떻게 지내는지 같이 둘러볼래?",
          "options": [
            {
              "id": "yes",
              "label": "좋아",
              "goto": "name"
            },
            {
              "id": "later",
              "label": "나중에",
              "goto": "brief"
            }
          ]
        }
      ]
    },
    {
      "id": "brief",
      "title": "이름만 알려 주기",
      "steps": [
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "알겠어. 그럼 이름만 알려 줘."
        },
        {
          "kind": "ask",
          "id": "name",
          "persona": "character-1",
          "expression": "호기심",
          "prompt": "뭐라고 부를까?",
          "input": "name",
          "known": "{userName}, 또 같이 둘러보는 거야?",
          "saved": {
            "expression": "기쁨",
            "text": "{userName}! 좋다. 이제 그렇게 부를게."
          }
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "기쁨",
          "text": "그럼 이제 같이 지내자, {userName}.",
          "motion": {
            "mode": "clip",
            "clipId": "gift",
            "repeat": false,
            "intervalMs": 0
          }
        }
      ],
      "next": "end"
    },
    {
      "id": "name",
      "title": "이름",
      "steps": [
        {
          "kind": "ask",
          "id": "name",
          "persona": "character-1",
          "expression": "호기심",
          "prompt": "뭐라고 부를까?",
          "input": "name",
          "known": "{userName}, 또 같이 둘러보는 거야?",
          "saved": {
            "expression": "기쁨",
            "text": "{userName}! 좋다. 이제 그렇게 부를게."
          }
        }
      ],
      "next": "talk"
    },
    {
      "id": "talk",
      "title": "말 걸기",
      "steps": [
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "나한테 할 말이 있으면 나를 눌러 봐."
        },
        {
          "kind": "wait",
          "event": "body.clicked",
          "timeoutSec": 60,
          "onTimeout": {
            "steps": [
              {
                "kind": "line",
                "persona": "character-1",
                "expression": "평온",
                "text": "나중에 눌러 봐도 돼."
              }
            ],
            "then": "move"
          },
          "appearance": {
            "persona": "character-1",
            "expression": "호기심"
          }
        },
        {
          "kind": "ask",
          "id": "message",
          "persona": "character-1",
          "expression": "호기심",
          "prompt": "아무 말이나 해 봐.",
          "input": "text"
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "기쁨",
          "text": "응, 잘 들었어."
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "생각중",
          "text": "지금은 내가 아는 말로만 대답하지만, 단어장에 말을 넣어 두면 네가 정한 대로 대답할게."
        }
      ],
      "next": "move"
    },
    {
      "id": "move",
      "title": "움직이기",
      "steps": [
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "장난",
          "text": "나를 끌어서 다른 데로 옮겨 볼래?"
        },
        {
          "kind": "wait",
          "event": "body.moved",
          "timeoutSec": 60,
          "onTimeout": {
            "steps": [
              {
                "kind": "line",
                "persona": "character-1",
                "expression": "평온",
                "text": "괜찮아, 나중에 옮겨 봐도 돼."
              }
            ],
            "then": "memo"
          },
          "appearance": {
            "persona": "character-1",
            "expression": "장난"
          }
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "기쁨",
          "text": "여기 좋다. 나는 네가 둔 곳에서 지낼게."
        }
      ],
      "next": "memo"
    },
    {
      "id": "memo",
      "title": "메모",
      "steps": [
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "같이 쓰는 위젯도 있어. 메모를 열어 볼게."
        },
        {
          "kind": "action",
          "do": "widget.open",
          "widget": "memo"
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "호기심",
          "text": "아무거나 한 줄 적고 저장해 봐."
        },
        {
          "kind": "wait",
          "event": "widget.saved",
          "timeoutSec": 180,
          "onTimeout": {
            "steps": [
              {
                "kind": "line",
                "persona": "character-1",
                "expression": "평온",
                "text": "다음에 적어도 돼."
              }
            ],
            "then": "focus"
          },
          "widget": "memo",
          "cancelOn": [
            {
              "event": "window.closed",
              "window": "memo"
            }
          ],
          "appearance": {
            "persona": "character-1",
            "expression": "생각중"
          }
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "기쁨",
          "text": "적었다! 적은 메모는 다이어리의 메모에서 다시 찾을 수 있어."
        }
      ],
      "next": "focus"
    },
    {
      "id": "focus",
      "title": "집중 타이머",
      "steps": [
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "집중할 땐 집중 타이머를 켜. 켜 두면 나도 조용히 있을게."
        },
        {
          "kind": "action",
          "do": "widget.open",
          "widget": "focus-timer"
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "호기심",
          "text": "시작을 눌러 볼래?"
        },
        {
          "kind": "wait",
          "event": "focus.started",
          "timeoutSec": 90,
          "onTimeout": {
            "steps": [
              {
                "kind": "line",
                "persona": "character-1",
                "expression": "평온",
                "text": "이번엔 내가 켜 볼게."
              },
              {
                "kind": "action",
                "do": "focus.start",
                "minutes": 5
              }
            ],
            "then": "next"
          },
          "cancelOn": [
            {
              "event": "window.closed",
              "window": "focus-timer"
            }
          ],
          "appearance": {
            "persona": "character-1",
            "expression": "호기심"
          }
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "집중하는 동안 나는 이렇게 책 볼게.",
          "motion": {
            "mode": "clip",
            "clipId": "focus",
            "repeat": false,
            "intervalMs": 0
          }
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "끝내려면 멈춰 봐.",
          "motion": {
            "mode": "clip",
            "clipId": "focus",
            "repeat": false,
            "intervalMs": 0
          }
        },
        {
          "kind": "wait",
          "event": "focus.stopped",
          "timeoutSec": 60,
          "onTimeout": {
            "steps": [
              {
                "kind": "action",
                "do": "focus.stop"
              },
              {
                "kind": "line",
                "persona": "character-1",
                "expression": "평온",
                "text": "다음엔 네가 직접 멈춰 봐."
              }
            ],
            "then": "next"
          },
          "appearance": {
            "persona": "character-1",
            "expression": "평온",
            "motion": {
              "mode": "clip",
              "clipId": "focus",
              "repeat": false,
              "intervalMs": 0
            }
          }
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "기쁨",
          "text": "끝! 집중하는 동안엔 내가 먼저 말 걸지 않아.",
          "motion": {
            "mode": "clip",
            "clipId": "idle-stretch",
            "repeat": false,
            "intervalMs": 0
          }
        }
      ],
      "next": "ai"
    },
    {
      "id": "ai",
      "title": "AI 연결",
      "steps": [
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "지금도 인사하고 대답할 수 있지만, AI를 연결하면 더 자유롭게 얘기할 수 있어."
        },
        {
          "kind": "choice",
          "persona": "character-1",
          "expression": "호기심",
          "prompt": "지금 연결해 볼래?",
          "options": [
            {
              "id": "connect",
              "label": "연결해 볼래",
              "goto": "ai-connect"
            },
            {
              "id": "later",
              "label": "나중에",
              "goto": "next"
            }
          ]
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "괜찮아. 나중에 설정 → AI 연결에서 하면 돼."
        }
      ],
      "next": "finish"
    },
    {
      "id": "ai-connect",
      "title": "AI 연결하기",
      "steps": [
        {
          "kind": "action",
          "do": "settings.open",
          "tab": "ai",
          "highlight": "ai.recommended"
        },
        {
          "kind": "wait",
          "event": "window.closed",
          "timeoutSec": 600,
          "onTimeout": {
            "steps": [],
            "then": "finish"
          },
          "window": "settings",
          "appearance": {
            "persona": "character-1",
            "expression": "생각중"
          }
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "기쁨",
          "text": "준비가 끝나면 그때부터 더 많이 얘기하자."
        }
      ],
      "next": "finish"
    },
    {
      "id": "finish",
      "title": "마무리",
      "steps": [
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "더 궁금한 건 안내서에 적어 뒀어."
        },
        {
          "kind": "choice",
          "persona": "character-1",
          "expression": "호기심",
          "prompt": "지금 열어 볼래?",
          "options": [
            {
              "id": "open",
              "label": "열어 줘",
              "goto": "guide"
            },
            {
              "id": "later",
              "label": "나중에",
              "goto": "ending"
            }
          ]
        }
      ],
      "next": "ending"
    },
    {
      "id": "guide",
      "title": "안내서",
      "steps": [
        {
          "kind": "action",
          "do": "guide.open",
          "page": "first-meeting"
        }
      ],
      "next": "ending"
    },
    {
      "id": "ending",
      "title": "함께 지내기",
      "steps": [
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "평온",
          "text": "이 이야기는 설정 → 일반 → 안내서에서 다시 볼 수 있어."
        },
        {
          "kind": "line",
          "persona": "character-1",
          "expression": "기쁨",
          "text": "그럼 이제 같이 지내자, {userName}.",
          "motion": {
            "mode": "clip",
            "clipId": "gift",
            "repeat": false,
            "intervalMs": 0
          }
        }
      ],
      "next": "end"
    }
  ]
}
