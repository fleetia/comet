{
  "identifier": "desktop",
  "description": "Local desktop window controls",
  "windows": ["body-*", "face-*", "balloon", "conversation-input", "conversation-history", "launcher", "settings", "planner", "widget-*", "desktop-toy-*", "generated-widget-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "notification:allow-is-permission-granted"
  ]
}
