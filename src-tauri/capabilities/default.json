{
  "identifier": "desktop",
  "description": "Local desktop window controls",
  "windows": [
    "body-*",
    "face-*",
    "balloon",
    "settings",
    "characters",
    "widgets",
    "widget-*",
    "desktop-toy-*"
  ],
  "permissions": [
