  "pairScenes": [
    [
      {
        "speaker": "builtin-a",
        "expression": "기쁨",
        "text": "왔네. 오늘도 여기서 같이 지내자."
      },
      {
        "speaker": "builtin-b",
        "expression": "평온",
        "text": "계속 대답해 주지는 않아도 돼. 우리끼리도 잘 놀거든."
      },
      {
        "speaker": "builtin-a",
        "expression": "호기심",
        "text": "그럼 오늘의 첫 번째 할 일은?"
      },
      {
        "speaker": "builtin-b",
        "expression": "장난",
        "text": "바탕화면 한쪽을 아주 성실하게 지키기."
      }
    ],
    [
      {
        "speaker": "builtin-a",
        "expression": "생각중",
        "text": "아무것도 안 하는 것도 계획에 넣을 수 있을까?"
      },
      {
        "speaker": "builtin-b",
        "expression": "평온",
        "text": "넣었어. 방금 시작했고."
      },
      {
        "speaker": "builtin-a",
        "expression": "기쁨",
        "text": "일 처리가 빠르네."
      }
    ],
    [
      {
        "speaker": "builtin-b",
        "expression": "호기심",
        "text": "너는 심심할 때 무슨 생각 해?"
      },
      {
        "speaker": "builtin-a",
        "expression": "생각중",
        "text": "심심하지 않을 방법을 생각하지."
      },
      {
        "speaker": "builtin-b",
        "expression": "장난",
        "text": "그 생각만 해도 꽤 바쁘겠다."
      }
    ],
    [
      {
        "speaker": "builtin-a",
        "expression": "호기심",
        "text": "우리한테 휴가가 생기면 어디로 갈까?"
      },
      {
        "speaker": "builtin-b",
        "expression": "평온",
        "text": "바탕화면 반대쪽."
      },
      {
        "speaker": "builtin-a",
        "expression": "장난",
        "text": "짐은 가볍게 챙겨도 되겠네."
      }
    ],
    [
      {
        "speaker": "builtin-a",
        "expression": "기쁨",
        "text": "나 방금 멋진 말을 생각했어."
      },
      {
        "speaker": "builtin-b",
        "expression": "호기심",
        "text": "뭔데?"
      },
      {
        "speaker": "builtin-a",
        "expression": "생각중",
        "text": "말하려니까 잊어버렸어."
      },
      {
        "speaker": "builtin-b",
        "expression": "장난",
        "text": "그럼 아직 가능성은 무한하네."
      }
    ],
    [
      {
        "speaker": "builtin-b",
        "expression": "생각중",
        "text": "작은 상자로 살아가는 기분은 어때?"
      },
      {
        "speaker": "builtin-a",
        "expression": "기쁨",
        "text": "정리가 잘 돼. 모서리가 있으니까."
      },
      {
        "speaker": "builtin-b",
        "expression": "장난",
        "text": "성격까지 네모나지면 곤란한데."
      }
    ],
    [
      {
        "speaker": "builtin-a",
        "expression": "호기심",
        "text": "오늘은 조용히 있어 볼까?"
      },
      {
        "speaker": "builtin-b",
        "expression": "평온",
        "text": "좋아."
      },
      {
        "speaker": "builtin-a",
        "expression": "생각중",
        "text": "근데 조용히 뭘 할지는 이야기해야 하지 않을까?"
      }
    ],
    [
      {
        "speaker": "builtin-a",
        "expression": "기쁨",
        "text": "여기 우리 자리라고 작은 이름표라도 붙일까?"
      },
      {
        "speaker": "builtin-b",
        "expression": "평온",
        "text": "이미 이름이 붙어 있어."
      },
      {
        "speaker": "builtin-a",
        "expression": "장난",
        "text": "준비가 철저한 집이네."
      }
    ]
