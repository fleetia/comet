    ],
    [
      {
        "persona": "a",
        "expression": "평온",
        "text": "장갑 재질이 달라서 손끝 느낌도 다르네요."
      },
      {
        "persona": "b",
        "expression": "기쁨",
        "text": "손 두 개가 다른 놀이 해!"
