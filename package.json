{
  "name": "comet-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "version:release": "changeset version && python3 scripts/release.py sync && python3 scripts/release.py check",
    "release:check": "python3 scripts/release.py check",
    "test:release": "vitest run --config vitest.release.config.ts && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "dev": "corepack pnpm --filter comet dev",
    "build": "corepack pnpm --filter comet build",
    "ds:generate": "corepack pnpm --filter './ds/*' run generate",
    "ds:storybook": "corepack pnpm --filter @comet/storybook dev",
    "ds:check": "corepack pnpm --filter './ds/*' run check:generated && tsc -p ds/tsconfig.json && corepack pnpm --filter @comet/storybook typecheck && corepack pnpm --filter @comet/storybook check:stories && oxlint ds",
    "test": "corepack pnpm --filter comet test && vitest run --config vitest.ds.config.ts",
    "check": "corepack pnpm ds:check && corepack pnpm --filter comet check",
    "test:widgets": "corepack pnpm --filter comet test:widgets",
    "test:widgets:host": "corepack pnpm --filter comet test:widgets:host",
    "test:widgets:browser": "corepack pnpm --filter comet test:widgets:browser",
    "tauri": "corepack pnpm --filter comet tauri",
    "desktop": "corepack pnpm --filter comet desktop",
    "prepare:sidecar": "corepack pnpm --filter comet prepare:sidecar",
    "build:desktop": "corepack pnpm --filter comet build:desktop",
    "test:rust": "corepack pnpm --filter comet test:rust",
    "talk": "corepack pnpm --filter comet talk",
    "prepare:nlp": "corepack pnpm --filter comet prepare:nlp",
    "test:native-runtime": "corepack pnpm --filter comet test:native-runtime"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.27.0"
}
