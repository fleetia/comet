{
  "name": "nanika-box",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "version:release": "changeset version && python3 scripts/release.py sync && python3 scripts/release.py check",
    "release:check": "python3 scripts/release.py check",
    "test:release": "vitest run --config vitest.release.config.ts && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "tsc -b && oxlint src",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "build:desktop": "pnpm prepare:sidecar && tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "docs:install": "corepack pnpm --dir wiki install --frozen-lockfile",
    "docs:dev": "corepack pnpm --dir wiki start",
    "docs:check": "corepack pnpm --dir wiki typecheck",
    "docs:build": "corepack pnpm --dir wiki build",
    "docs:serve": "corepack pnpm --dir wiki serve",
    "talk": "cargo run --manifest-path src-tauri/Cargo.toml --example talk --"
  },
  "dependencies": {
    "@fleetia/lagrange": "0.2.2",
    "@tauri-apps/api": "^2.11.1",
    "@vanilla-extract/css": "^1.21.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
