{
  "name": "@comet/storybook",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "storybook dev --host 127.0.0.1 --port 6006 --no-open",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:stories": "node -e \"require('node:fs').mkdirSync('../../test-results', { recursive: true })\" && storybook index --output-file ../../test-results/storybook-index.json --disable-telemetry"
  },
  "dependencies": {
    "@comet/icon": "workspace:*",
    "@comet/token": "workspace:*",
    "@comet/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "storybook": "10.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
